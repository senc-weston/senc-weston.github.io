---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
const { post } = Astro.props;
const { title, description, date, tags } = post.data;
---
<Base title={title} description={description}>
  <a class="back-link" href="/">&larr; All posts</a>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <div class="post-meta">
        <FormattedDate date={date} />
        {tags.length > 0 && <span>·</span>}
        <span class="tag-row">
          {tags.map((tag) => <a class="tag" href={`/tags/${tag}`}>{tag}</a>)}
        </span>
      </div>
    </header>
    <slot />
  </article>
  <aside class="post-updates">
    <h2>Follow the next steps</h2>
    <p><a href="/updates">Get updates</a> when I publish a new post.</p>
  </aside>
</Base>

<style>
  .post-updates { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.5rem; }
  .post-updates h2 { margin-top: 0; font-size: 1.15rem; }
  .post-updates p { margin-bottom: 0; }
</style>
